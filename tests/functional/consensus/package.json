{
	"name": "@mainsail/functional-consensus",
	"version": "0.0.1-alpha.20",
	"description": "Functional tests for Mainsail blockchain",
	"license": "GPL-3.0-only",
	"contributors": [],
	"type": "module",
	"scripts": {
		"test": "pnpm run uvu source .test.ts",
		"test:check": "tsc -p tsconfig.test.json --noEmit",
		"test:full": "pnpm run test:check && pnpm run test",
		"test:coverage": "c8 -r=text -r=lcov --all pnpm run test",
		"test:coverage:html": "c8 -r html --all pnpm run test",
		"test:file": "pnpm run uvu source",
		"uvu": "tsx --tsconfig tsconfig.test.json ./node_modules/uvu/bin.js"
	},

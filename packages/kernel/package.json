{
	"name": "@mainsail/kernel",
	"version": "0.0.1-evm.37",
	"description": "Kernel for the Mainsail blockchain",
	"license": "GPL-3.0-only",
	"contributors": [],
	"type": "module",
	"main": "distribution/index.js",
	"browser": {
		"fs": false,
		"path": false,
		"os": false,
		"child_process": false
	},
	"types": "distribution/index.d.ts",
	"files": [
		"/distribution"
	],
	"scripts": {
		"build": "tsc -b",
		"build:watch": "pnpm run clean && tsc -w",
		"release": "pnpm publish --access public",
		"test": "pnpm run uvu source .test.ts",
		"test:coverage": "c8 -r=text -r=lcov --all pnpm run test",
		"test:coverage:html": "c8 -r html --all pnpm run test",
		"test:file": "pnpm run uvu source",
		"uvu": "tsx --tsconfig ../../tsconfig.test.json ./node_modules/uvu/bin.js"
	},
	"dependencies": {
		"@mainsail/container": "workspace:*",
		"@mainsail/contracts": "workspace:*",
		"@mainsail/utils": "workspace:*",
		"chalk": "5.6.0",
		"cron": "4.3.3",
		"date-fns": "4.1.0",
		"deepmerge": "4.3.1",
		"env-paths": "3.0.0",
		"fs-extra": "11.3.1",
		"glob": "11.0.3",
		"joi": "18.0.0",
		"log-process-errors": "12.0.1",
		"nanomatch": "1.2.13",
		"nsfw": "2.2.5",
		"semver": "7.7.2",
		"split2": "4.2.0"
	},
	"devDependencies": {
		"@types/capture-console": "1.0.5",
		"@types/fs-extra": "11.0.4",
		"@types/log-process-errors": "9.1.0",
		"@types/semver": "7.7.0",
		"@types/split2": "4.2.3",
		"@types/tmp": "0.2.6",
		"capture-console": "1.0.2",
		"moment-timezone": "0.6.0",
		"tmp": "0.2.5",
		"uvu": "0.5.6"
	},
	"engines": {
		"node": ">=20.x"
	}
}

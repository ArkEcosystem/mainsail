{
	"name": "@mainsail/p2p",
	"version": "0.0.1-rc.9",
	"description": "P2P for the Mainsail blockchain",
	"license": "GPL-3.0-only",
	"contributors": [],
	"type": "module",
	"main": "distribution/index.js",
	"types": "distribution/index.d.ts",
	"files": [
		"/distribution"
	],
	"scripts": {
		"build": "tsc -b && pnpm copy:protos",
		"build:proto": "pnpm pbjs && pnpm pbts",
		"build:watch": "pnpm run clean && tsc -w",
		"copy:protos": "node scripts/copy-protos.mjs",
		"pbjs": "pbjs -t static-module -w esm source/socket-server/codecs/proto/*.proto -o source/socket-server/codecs/proto/protos.js",
		"pbts": "pbts source/socket-server/codecs/proto/protos.js -o source/socket-server/codecs/proto/protos.d.ts",
		"release": "pnpm publish --access public",
		"test": "pnpm run uvu source .test.ts",
		"test:coverage": "c8 --experimental-monocart -r=text -r=lcov --all pnpm run test",
		"test:file": "pnpm run uvu source",
		"uvu": "tsx --tsconfig ../../tsconfig.test.json ./node_modules/uvu/bin.js"
	},
	"dependencies": {
		"@hapi/boom": "10.0.1",
		"@hapi/bounce": "3.0.2",
		"@hapi/hapi": "21.4.10",
		"@hapi/hoek": "11.0.7",
		"@hapi/teamwork": "6.0.1",
		"@mainsail/blockchain-utils": "workspace:*",
		"@mainsail/constants": "workspace:*",
		"@mainsail/container": "workspace:*",
		"@mainsail/exceptions": "workspace:*",
		"@mainsail/kernel": "workspace:*",
		"@mainsail/utils": "workspace:*",
		"ajv": "8.20.0",
		"dayjs": "1.11.23",
		"delay": "7.0.0",
		"fs-extra": "11.4.0",
		"ipaddr.js": "2.5.0",
		"joi": "18.2.5",
		"long": "5.3.2",
		"protobufjs": "8.7.2",
		"rate-limiter-flexible": "11.2.0",
		"semver": "7.8.5",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@mainsail/contracts": "workspace:*",
		"@mainsail/crypto-block": "workspace:*",
		"@mainsail/crypto-config": "workspace:*",
		"@mainsail/crypto-transaction": "workspace:*",
		"@mainsail/crypto-validation": "workspace:*",
		"@mainsail/test-runner": "workspace:*",
		"@mainsail/validation": "workspace:*",
		"@types/fs-extra": "11.0.4",
		"@types/hapi__sntp": "3.1.4",
		"@types/semver": "7.8.0",
		"@types/ws": "8.18.1",
		"esmock": "2.7.6",
		"protobufjs-cli": "2.6.2",
		"uvu": "0.5.6"
	},
	"engines": {
		"node": ">=24"
	}
}

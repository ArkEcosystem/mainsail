{
	"name": "@mainsail/api-common",
	"version": "0.0.1-evm.35",
	"description": "Common API building blocks for the Mainsail blockchain",
	"license": "GPL-3.0-only",
	"contributors": [],
	"type": "module",
	"main": "distribution/index.js",
	"types": "distribution/index.d.ts",
	"files": [
		"/distribution"
	],
	"scripts": {
		"build": "tsc -b",
		"build:watch": "pnpm run clean && tsc -w",
		"clean": "del distribution && del tsconfig.tsbuildinfo",
		"release": "pnpm publish --access public",
		"test": "pnpm run uvu source .test.ts",
		"test:coverage": "c8 -r=text -r=lcov --all pnpm run test",
		"test:coverage:html": "c8 -r html --all pnpm run test",
		"test:file": "pnpm run uvu source",
		"uvu": "tsx --tsconfig ../../tsconfig.test.json ./node_modules/uvu/bin.js"
	},
	"dependencies": {
		"@hapi/boom": "10.0.1",
		"@hapi/hapi": "21.4.3",
		"@hapi/hoek": "11.0.7",
		"@mainsail/api-database": "workspace:*",
		"@mainsail/container": "workspace:*",
		"@mainsail/contracts": "workspace:*",
		"@mainsail/kernel": "workspace:*",
		"@mainsail/utils": "workspace:*",
		"ajv": "8.17.1",
		"joi": "18.0.0",
		"nanomatch": "1.2.13",
		"rate-limiter-flexible": "7.2.0"
	},
	"devDependencies": {
		"@types/ip": "1.1.3",
		"@types/semver": "7.7.0",
		"uvu": "0.5.6"
	},
	"engines": {
		"node": ">=20.x"
	}
}
